# All optional. Without them the site still works: the contact form falls back
# to the visitor's mail app and the HUD shows "local" instead of live data.

# Contact form → email (https://resend.com, free tier is enough)
RESEND_API_KEY=
CONTACT_TO=kavya.ugupta@gmail.com
# Must be a sender on a domain verified in Resend (onboarding@resend.dev works for testing)
CONTACT_FROM="Dragon Post <onboarding@resend.dev>"

# Contact form → any webhook, e.g. an n8n workflow (Telegram, Sheets, Notion…)
CONTACT_WEBHOOK_URL=

# Live GitHub stats without rate limits (a fine-grained token with no scopes is enough)
GITHUB_TOKEN=

# Visitor counter + durable rate limiting (Upstash Redis / Vercel KV integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical origin for SEO tags (defaults to the Vercel production domain)
SITE_URL=
